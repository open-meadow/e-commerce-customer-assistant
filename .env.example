# Copy to .env (git-ignored) and adjust. Real environment variables override this file.

# SQLite database used by the app and the seed command. A relative path resolves from
# the project root. Create it once: uv run python -m app.db.seed_data --reference-time <now, UTC>
APP_DB_PATH=app/db/data/app_d2.db

# Which backend the Streamlit UI uses: real (default) or fake (canned demo, no database).
# UI_BACKEND=real

# Language model. Leave unset for the offline rule-based assistant.
# LLM_PROVIDER=anthropic
# LLM_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
