# Copy to .env (git-ignored) and adjust. Real environment variables override this file.

# Local SQLite database. Docker Compose overrides this with its persistent
# /app/data/app_d2.db volume path.
APP_DB_PATH=app/db/data/app_d2.db

# Local UI backend. Docker Compose explicitly selects the real backend.
# UI_BACKEND=real

# Language model. Leave unset for the offline rule-based assistant.
# LLM_PROVIDER=anthropic
# LLM_MODEL=
# ANTHROPIC_API_KEY=
# Required for FAQ/policy vector retrieval and voice transcription; also used
# by the OpenAI LLM.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# LiveKit voice services (keep credentials server-side; never expose them to the browser).
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# OpenAI STT model and Fish Audio TTS via LiveKit Inference.
# LIVEKIT_STT_MODEL=gpt-4o-mini-transcribe
# LIVEKIT_TTS_MODEL=fishaudio/s2.1-pro
# Fish Audio voice ID (not a Fish API key).
# FISH_AUDIO_VOICE=

# Local persistent Chroma index (Docker Compose uses /app/data/vector_store).
VECTOR_STORE_DIR=app/db/data/generated/vector_store
