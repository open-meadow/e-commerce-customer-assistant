# Copy to .env (git-ignored) and adjust. Real environment variables override this file.

# Local SQLite database. Docker Compose overrides this with its persistent
# /app/data/app_d2.db volume path.
APP_DB_PATH=app/db/data/app_d2.db

# Local UI backend. Docker Compose explicitly selects the real backend.
# UI_BACKEND=real

# Language model. Leave unset for the offline rule-based assistant.
# LLM_PROVIDER=anthropic
# LLM_MODEL=
# ANTHROPIC_API_KEY=
# Required for FAQ/policy vector retrieval and voice transcription; also used
# by the OpenAI LLM.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# LiveKit voice services (keep credentials server-side; never expose them to the browser).
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# OpenAI STT model and Fish Audio TTS via LiveKit Inference.
# LIVEKIT_STT_MODEL=gpt-4o-mini-transcribe
# LIVEKIT_TTS_MODEL=fishaudio/s2.1-pro
# OpenAI model used by the voice agent to route turns to the support backend.
# LIVEKIT_AGENT_MODEL=gpt-4o-mini
# Fish Audio voice ID (not a Fish API key).
# FISH_AUDIO_VOICE=
# Internal FastAPI base URL used by Streamlit and the LiveKit worker.
# SUPPORT_API_URL=http://api:8000

# Session and resource protection (H3). Optional; the defaults suit a demo. Limits apply per process:
# see docs/session_resource_protection.md. An unset, unparsable or non-positive value keeps the default.
# SUPPORT_MAX_SESSIONS=200                       # active sessions, all clients
# SUPPORT_SESSIONS_PER_CLIENT_PER_MINUTE=10      # session creations per peer address
# SUPPORT_SESSIONS_PER_MINUTE=60                 # session creations, all clients
# SUPPORT_IDLE_TIMEOUT_SECONDS=3600              # idle expiry
# SUPPORT_MAX_SESSION_AGE_SECONDS=28800          # absolute lifetime (activity does not extend it)
# SUPPORT_MAX_REQUESTS_PER_SESSION=300           # messages, confirmations and choices per session
# SUPPORT_REQUESTS_PER_SESSION_PER_MINUTE=30     # request rate per session
# SUPPORT_REQUESTS_PER_CLIENT_PER_MINUTE=120     # HTTP request rate per peer address
# SUPPORT_MAX_BODY_BYTES=16384                   # HTTP request body limit
# SUPPORT_TURN_LOCK_TIMEOUT_SECONDS=40           # how long a request waits for the session's previous turn
# SUPPORT_PROVIDER_CALLS_PER_SESSION=300         # model calls per session
# SUPPORT_PROVIDER_CALLS_PER_MINUTE=240          # model calls per minute, all sessions
# SUPPORT_LIVEKIT_TIMEOUT_SECONDS=10             # LiveKit agent dispatch and room release
# SUPPORT_SWEEP_INTERVAL_SECONDS=60              # background cleanup of expired sessions
# SUPPORT_SHUTDOWN_TIMEOUT_SECONDS=20            # all LiveKit room releases at shutdown, overall
# SUPPORT_VOICE_MAX_SECONDS=1800                 # voice worker: longest call
# SUPPORT_VOICE_IDLE_SECONDS=300                 # voice worker: longest silence
# LLM_TIMEOUT_SECONDS=20                         # provider call timeout, 1..120 (outside it is rejected); calls are never retried
#
# Service-to-service secrets (16 to 256 printable characters, no spaces; the two must differ). Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# SUPPORT_AGENT_TOKEN=   # voice worker -> /api/agent/*. REQUIRED for voice: without it those endpoints answer 503.
# SUPPORT_UI_TOKEN=      # Streamlit -> API: lets the API trust the browser identifier Streamlit sends, so each browser gets
#                        # its own rate-limit bucket. Without it every voice user behind Streamlit shares one bucket.
#
# Every SUPPORT_* value is range-checked at startup. An invalid value stops the API (and the voice worker) with a message
# naming the variable; it is never silently replaced. The ranges are in docs/session_resource_protection.md.

# Local persistent Chroma index (Docker Compose uses /app/data/vector_store).
VECTOR_STORE_DIR=app/db/data/generated/vector_store
