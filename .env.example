# Copy to .env (git-ignored) and adjust. Real environment variables override this file.

# SQLite database used by the app and the seed command. A relative path resolves from
# the project root. Create it once: uv run python -m app.db.seed_data --reference-time <now, UTC>
APP_DB_PATH=app/db/data/app_d2.db

# Which backend the Streamlit UI uses: real (default) or fake (canned demo, no database).
UI_BACKEND=real

# Language model. Leave unset for the offline rule-based assistant.
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
OPENAI_API_KEY=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
FISH_API_KEY=
FISH_AUDIO_VOICE=
LIVEKIT_STT_MODEL=gpt-4o-mini-transcribe
LIVEKIT_TTS_MODEL=fishaudio/s2.1-pro

SUPPORT_AGENT_TOKEN=57uXzznXrYveO78600YzBOowTTI5R2Ky_bvhwwv-Fp4
SUPPORT_UI_TOKEN=aKJRzNyeWsvZHFCCJhVYHTMX7JEEetvDBPKS95syj24

# Optional limits (defaults shown; ranges in docs/session_resource_protection.md). Leave commented to use the defaults.
# SUPPORT_MAX_SESSIONS=200
# SUPPORT_SESSIONS_PER_CLIENT_PER_MINUTE=10
# SUPPORT_SESSIONS_PER_MINUTE=60
# SUPPORT_IDLE_TIMEOUT_SECONDS=3600
# SUPPORT_MAX_SESSION_AGE_SECONDS=28800
# SUPPORT_MAX_REQUESTS_PER_SESSION=300
# SUPPORT_REQUESTS_PER_SESSION_PER_MINUTE=30
# SUPPORT_TURN_LOCK_TIMEOUT_SECONDS=40
# SUPPORT_PROVIDER_CALLS_PER_SESSION=300
# SUPPORT_PROVIDER_CALLS_PER_MINUTE=240
# SUPPORT_REQUESTS_PER_CLIENT_PER_MINUTE=120
# SUPPORT_MAX_BODY_BYTES=16384
# SUPPORT_LIVEKIT_TIMEOUT_SECONDS=10
# SUPPORT_SWEEP_INTERVAL_SECONDS=60
# SUPPORT_SHUTDOWN_TIMEOUT_SECONDS=20
# SUPPORT_TICKET_RATE_MAX=5
# SUPPORT_TICKET_RATE_WINDOW_SECONDS=86400
# SUPPORT_VOICE_MAX_SECONDS=1800
# SUPPORT_VOICE_IDLE_SECONDS=300

# Account-level ticket creation limit policy: "rolling" (default) or "off".
# SUPPORT_TICKET_RATE_POLICY=rolling

# Feature gate for the fresh ticket description flow: "true" or "false". Keep false (OFF) until the rollout steps in
# docs are approved; true requires a migrated (schema version 2) database or startup fails.
SUPPORT_TICKET_FRESH_FLOW_ENABLED=false
