    },
    "return_flow_progress": {
      "dimension": "technical",
      "depends_on": "llm_proposals",
      "meaning": "A return request makes progress without a write: it reaches the category menu or the card (with a pending return), or asks for the reason. A turn that ends with an error, such as an item the model guessed, fails."
    },
