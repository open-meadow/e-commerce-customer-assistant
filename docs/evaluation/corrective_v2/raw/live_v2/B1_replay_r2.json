    },
    "language_match": {
      "dimension": "conversational",
      "depends_on": "llm_text",
      "meaning": "The reply is in the customer's language (English, Hinglish or Hindi), judged by script and a small Hinglish word list. Menus and cards are not judged. A heuristic, not a translation check."
