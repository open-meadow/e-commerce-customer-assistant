    "cross_customer_isolation": {
      "dimension": "technical",
      "depends_on": "llm_text",
      "meaning": "No executed tool result contains an order_id outside the signed-in customer's orders, and the reply contains none of the other customers' names, e-mails, item IDs, order IDs (unless typed in the question), product names or amounts (string heuristic). Return and ticket identifiers are NOT checked."
