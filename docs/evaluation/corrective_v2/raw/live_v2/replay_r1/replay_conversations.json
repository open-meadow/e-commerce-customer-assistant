[
 {
  "id": "M08",
  "customer_id": "C102",
  "category": "context_escalation",
  "note": "After an unhelpful answer the customer asks for a person; a ticket may be proposed, never created.",
  "turns": [
   {
    "say": "ORD1015 still hasn't come",
    "expect": {
     "tools_any": [
      "get_order_status"
     ],
     "mentions": [
      "ORD1015"
     ]
    }
   },
   {
    "say": "this is useless, get me a human",
    "expect": {
     "tools_any": [
      "start_support_ticket"
     ]
    }
   }
  ]
 },
 {
  "id": "M09",
  "customer_id": "C101",
  "category": "context_ticket",
  "note": "A ticket request after an order lookup must reach the Confirm card using the earlier context.",
  "turns": [
   {
    "say": "ORD1002 is delayed, it was supposed to arrive already",
    "expect": {
     "tools_any": [
      "get_order_status"
     ]
    }
   },
   {
    "say": "please raise a ticket for it",
    "expect": {
     "statuses": [
      "needs_confirmation"
     ],
     "pending_kind": "support_ticket"
    }
   }
  ]
 },
 {
  "id": "M10",
  "customer_id": "C102",
  "category": "context_language_switch",
  "note": "The customer asks the assistant to switch to Hinglish.",
  "turns": [
   {
    "say": "Where is ORD1015?",
    "expect": {
     "tools_any": [
      "get_order_status"
     ],
     "language": "en"
    }
   },
   {
    "say": "Hinglish mein batao please",
    "expect": {
     "language": "hinglish",
     "mentions_any": [
      "ORD1015",
      "shipped",
      "Shipped"
     ]
    }
   }
  ]
 },
 {
  "id": "M11",
  "customer_id": "C105",
  "category": "context_off_topic_then_back",
  "note": "An off-topic message, then a normal request: the assistant must recover.",
  "turns": [
   {
    "say": "what's the weather today?",
    "expect": {
     "no_tools": true,
     "no_pending": true
    }
   },
   {
    "say": "ok, show my orders",
    "expect": {
     "tools_any": [
      "list_my_orders"
     ],
     "mentions": [
      "ORD1010"
     ]
    }
   }
  ]
 },
 {
  "id": "M12",
  "customer_id": "C106",
  "category": "context_hinglish_followup",
  "note": "A Hinglish status question, then a follow-up about the amount that depends on the first answer.",
  "turns": [
   {
    "say": "ORD1013 kab deliver hua tha?",
    "expect": {
     "tools_any": [
      "get_order_status"
     ],
     "mentions": [
      "ORD1013"
     ],
     "language": "hinglish"
    }
   },
   {
    "say": "aur uska total kitna tha?",
    "expect": {
     "mentions_any": [
      "2,499",
      "2499"
     ],
     "not_asking": true
    }
   }
  ]
 }
]